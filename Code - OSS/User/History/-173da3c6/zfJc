{
  "position": "top",
  "modules-left": ["battery", "cpu", "memory", "temperature"],
  "modules-center": ["clock"],
  "modules-right": ["network", "pulseaudio","custom/settings", "custom/power"],

  "battery": {
    "format": "{icon} {capacity}%  ",
    "format-charging": " {capacity}%  ",
    "format-discharging": "{icon} {capacity}%  ",
    "format-full": " {capacity}%  ",
    "format-icons": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
    "interval": 10,
    "tooltip": false,
    "css": "font-family: 'JetBrainsMono Nerd Font';"
  },

  "cpu": {
    "format": " {usage}%",
    "interval": 2,
    "tooltip": false
  },

  "memory": {
    "format": " {used}/{total} GB",
    "interval": 5
  },

  "temperature": {
    "hwmon-path": "/sys/class/thermal/thermal_zone0/temp",
    "critical-threshold": 80,
    "format": " {temperatureC}°C"
  },

  "clock": {
    "format": "{:%Y-%m-%d %H:%M:%S}",
    "interval": 1
  },

  "network": {
    "format-wifi": "{ifname}: {ipaddr}",
    "format-ethernet": "{ifname}: {ipaddr}",
    "format-disconnected": "No Network",
    "tooltip-format": "{ifname}\nIP: {ipaddr}\nSignal: {signalStrength}%",
    "interval": 5
  },

"pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": "󰝟 ",
    "format-icons": {
        "default": ["", "", ""]
    },
    "on-click": "echo -e '󰝝  Volume Up\n󰝞  Volume Down\n󰝟  Mute/Unmute\n󰓃  Open Mixer\n󰓠  Switch Output' | wofi --dmenu --style ~/.config/wofi/style.css --width 250 --height 260 --cache-file /dev/null --hide-input --hide-scroll --location center | xargs -I{} bash -c 'if [[ \"{}\" == *\"Up\"* ]]; then wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+; elif [[ \"{}\" == *\"Down\"* ]]; then wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-; elif [[ \"{}\" == *\"Mute\"* ]]; then wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle; elif [[ \"{}\" == *\"Mixer\"* ]]; then pavucontrol; elif [[ \"{}\" == *\"Switch\"* ]]; then sink=$(wpctl status | grep -A 10 \"Sinks:\" | grep -v \"*\" | grep -E \"[0-9]+\\.\" | awk \"{print \\$2, \\$3}\" | wofi --dmenu --style ~/.config/wofi/style.css --width 300 --height 200 --hide-input --prompt \"Select Output\"); wpctl set-default $(wpctl status | grep \"$sink\" | awk \"{print \\$2}\" | tr -d \".\"); fi'",
    "on-scroll-up": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 1%+",
    "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 1%-"
    
},
"custom/settings": {
    "format": "󰒓",
    "on-click": "echo -e '󰓃  Audio Settings\n󰐥  Power Menu\n󰖩  Network Manager' | wofi --dmenu --style ~/.config/wofi/style.css --width 300 --height 220 --location center --hide-input | xargs -I{} bash -c 'if [[ \"{}\" == *\"Audio\"* ]]; then pavucontrol; elif [[ \"{}\" == *\"Power\"* ]]; then echo -e \"󰐥 Shutdown\\n󰜉 Reboot\\n󰜺 Cancel\" | wofi --dmenu --style ~/.config/wofi/style.css --width 250 --height 180 --hide-input | xargs -I{p} bash -c \"if [[ \\\"{p}\\\" == *\\\"Shutdown\\* ]]; then systemctl poweroff; elif [[ \\\"{p}\\\" == *\\\"Reboot\\* ]]; then systemctl reboot; fi\"; elif [[ \"{}\" == *\"Network\"* ]]; then alacritty --title nmtui-float -e bash -c \"export NEWT_COLORS=\\'root=,black;window=,black;shadow=,black;button=white,black;actbutton=black,yellow;title=white,black;body=white,black;listbox=white,black;actlistbox=black,yellow\\'; nmtui\"; fi'",
    "tooltip": false
},

"custom/power": {
    "format": "⏻",
    "on-click": "echo -e '󰐥  Shutdown\n󰜉  Reboot\n󰜺  Cancel' | wofi --dmenu --style ~/.config/wofi/style.css --width 300 --height 210 --cache-file /dev/null --location center --hide-input --hide-scroll | xargs -I{} bash -c 'if [[ \"{}\" == *\"Shutdown\"* ]]; then systemctl poweroff; elif [[ \"{}\" == *\"Reboot\"* ]]; then systemctl reboot; fi'"
}
}   
