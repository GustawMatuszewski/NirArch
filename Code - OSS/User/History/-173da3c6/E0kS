{
    "layer": "top",
    "position": "top",
    "height": 34,
    "spacing": 4,
    "modules-left": ["battery", "cpu", "memory", "temperature"],
    "modules-center": ["clock"],
    "modules-right": ["network", "pulseaudio", "custom/settings", "custom/power"],

    "battery": {
        "format": "{icon} {capacity}%",
        "format-icons": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
        "interval": 10
    },
    "cpu": { "format": " {usage}%" },
    "memory": { "format": " {used}G" },
    "temperature": { "format": " {temperatureC}°C" },
    "clock": { "format": "{:%H:%M:%S}", "interval": 1 },
    "network": {
        "format-wifi": " {essid}",
        "format-ethernet": "󰈀 {ifname}",
        "format-disconnected": "󰖪",
        "on-click": "alacritty --title nmtui-float -e nmtui"
    },
    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-icons": ["󰕿", "󰖀", "󰕾"],
        "on-click": "~/.config/scripts/audio-menu.sh"
    },
    "custom/settings": {
        "format": "󰒓",
        "on-click": "~/.config/scripts/menu.sh"
    },
    "custom/power": {
        "format": "⏻",
        "on-click": "~/.config/scripts/power-menu.sh"
    }
}