max-visible=5
sort=-time
layer=overlay

# Position
anchor=top-right
margin=20,50

# Style
font=sans-serif 11
width=300
height=110
border-size=2
border-radius=8
padding=15

# Colors (Niri match)
background-color=#1e1e2eff
text-color=#cdd6f4ff
border-color=#e69934ff

# The progress bar settings (only shows if app sends progress)
progress-color=over #e69934ff

# 3 Second timeout
default-timeout=3000

[urgency=high]
border-color=#9b0000ff
default-timeout=0