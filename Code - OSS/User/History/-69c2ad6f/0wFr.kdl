input {
    keyboard { xkb {} }
    touchpad {
        tap
        natural-scroll
    }
}

output "DP-1" {
    mode "1920x1080@119.982002"
    position x=1920 y=0
}

output "HDMI-A-1" {
    mode "1920x1080@75"
    position x=0 y=0
}

layout {
    gaps 10
    center-focused-column "never"
    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }
    default-column-width { proportion 0.5; }
    focus-ring {
        width 3
        active-color "#e69934ff"
        inactive-color "#505050"
    }
    border {
        width 1
        active-color "#e69934ff"
        inactive-color "#505050"
    }
}

spawn-at-startup "waybar"
spawn-at-startup "swaync"

animations {
    // This creates the "smaller" look during swap by using a snappy spring
    window-movement {
        spring damping-ratio=0.7 stiffness=800 epsilon=0.0001
    }
    workspace-switch {
        spring damping-ratio=0.8 stiffness=600 epsilon=0.0001
    }
}

// Separate rules to avoid validation errors
window-rule {
    match is-active=false
    opacity 0.7
}

window-rule {
    match app-id=r#"firefox$"# title="^Picture-in-Picture$"
    open-floating true
}

binds {
    Mod+Return { spawn "alacritty"; }
    Mod+D { spawn "fuzzel"; }
    Mod+M { spawn-sh "wofi --show drun"; }
    Mod+Q { close-window; }
    Mod+O { toggle-overview; }

    // Navigation (Arrows)
    Mod+Left  { focus-column-left; }
    Mod+Right { focus-column-right; }
    Mod+Up    { focus-workspace-up; }
    Mod+Down  { focus-workspace-down; }

    // Moving/Swapping (Shift + Arrows)
    Mod+Shift+Left  { move-column-left; }
    Mod+Shift+Right { move-column-right; }
    Mod+Shift+Up    { move-column-to-workspace-up; }
    Mod+Shift+Down  { move-column-to-workspace-down; }

    // Precision/Inside Column (Ctrl + Arrows)
    Mod+Ctrl+Left  { focus-column-left; }
    Mod+Ctrl+Right { focus-column-right; }
    Mod+Ctrl+Up    { focus-window-up; }
    Mod+Ctrl+Down  { focus-window-down; }

    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
}